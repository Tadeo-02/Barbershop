# Server Configuration
PORT=3001

# JWT secret used to sign authentication tokens
# Generate a strong value with: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret

# Frontend URL (for CORS configuration)
# Development: http://localhost:5173
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# Email Configuration (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
MAIL_FROM=Barbershop <no-reply@barbershop.com>

# Optional app base URL for links in emails
APP_BASE_URL=http://localhost:5173

# Token expiration windows (minutes)
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Database Configuration
DB_HOST=your-database-host
DB_USER=your-database-user
DB_PASS=your-database-password
DB_NAME=your-database-name

# Prisma MySQL Database URL
# Format: mysql://USER:PASSWORD@HOST/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@HOST/DATABASE"

# Security Settings (Optional - defaults are set in code)
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# RATE_LIMIT_MAX=100           # max requests per window
# AUTH_RATE_LIMIT_MAX=5        # max auth attempts per window

# ARCA (ex-AFIP) - Electronic Billin
# get access_token on https://app.afipsdk.com
AFIP_ACCESS_TOKEN=tu-access-token-aqui
# Business CUIT (without hyphens). Default: 20409378472 (testing)
AFIP_CUIT=20409378472
# "testing" o "production"
AFIP_ENVIRONMENT=testing
# Point of sale enabled for electronic invoicing.
AFIP_PUNTO_VENTA=1
# only production: rutes to certificate and key
# AFIP_CERT_PATH=./certs/certificado.crt
# AFIP_KEY_PATH=./certs/clave.key
