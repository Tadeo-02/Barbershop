# Server Configuration
PORT=3001

# Frontend-only: Full backend URL for API requests (leave empty for Vite dev proxy)
# In production: https://your-backend-domain.onrender.com
VITE_API_URL=

# JWT secret used to sign authentication tokens
# Generate a strong value with: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret

# Frontend URL (for CORS configuration)
# Development: http://localhost:5173
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# Email Configuration (Resend API)
RESEND_API_KEY=re_YOUR_API_KEY_HERE
MAIL_FROM=onboarding@resend.dev

# Optional app base URL for links in emails
APP_BASE_URL=http://localhost:5173

# Token expiration windows (minutes)
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Database Configuration
DB_HOST=your-database-host
DB_USER=your-database-user
DB_PASS=your-database-password
DB_NAME=your-database-name

# Prisma MySQL Database URL
# Format: mysql://USER:PASSWORD@HOST/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@HOST/DATABASE"

# Security Settings (Optional - defaults are set in code)
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# RATE_LIMIT_MAX=100           # max requests per window
# AUTH_RATE_LIMIT_MAX=5        # max auth attempts per window
# BCRYPT_SALT_ROUNDS=12        # password hashing rounds (higher = slower but safer)

# NODE_ENV controls cookie security flags (Secure, SameSite)
# Set to "production" in deployed environments
# NODE_ENV=production

# Cookie domain for cross-origin cookie storage (production only)
# When frontend and backend are on different domains, cookies must be set
# on the frontend domain so the browser stores and sends them correctly.
# Example: ".vercel.app" (with leading dot for subdomain matching)
# COOKIE_DOMAIN=.vercel.app

# Logging Configuration
# LOG_LEVEL: debug | info | warn | error
# Default: debug (development) / info (production)
# LOG_LEVEL=debug
# Optional: send logs to an external service (Better Stack / Logtail / Datadog)
# LOG_REMOTE_URL=https://in.logtail.com
# LOG_REMOTE_TOKEN=your-token-here

# ARCA (ex-AFIP) - Electronic Billin
# get access_token on https://app.afipsdk.com
AFIP_ACCESS_TOKEN=tu-access-token-aqui
# Business CUIT (without hyphens). Default: 20409378472 (testing)
AFIP_CUIT=20409378472
# "testing" o "production"
AFIP_ENVIRONMENT=testing
# Point of sale enabled for electronic invoicing.
AFIP_PUNTO_VENTA=1
# only production: rutes to certificate and key
# AFIP_CERT_PATH=./certs/certificado.crt
# AFIP_KEY_PATH=./certs/clave.key
